---
import { withBase } from "../lib/url";
import { localeHome, routeFor, altRouteFor, type Locale, type PageKey } from "../lib/i18n";
// Processed by Vite: minified, content-hashed, base-path aware. The @font-face
// URL inside resolves relative to the stylesheet, so the woff2 is emitted as a
// hashed asset too — no third-party font request either way.
import "../assets/css/site.css";

interface NavContent {
  contactLabel: string; contactHref: string;
  home: string;
  offers: string; cases: string; trust: string; about: string;
  contactPage: string; kennis: string; privacy: string;
  menuLabel: string; langSwitchLabel: string;
}
interface FactsContent {
  legalName: string; kvk: string; btw: string; address: string; phone: string;
  privacyLabel: string; isoLabel: string; isoHref: string;
  microsoftPartnerLabel: string; microsoftPartnerHref: string;
  anthropicPartnerLabel: string; anthropicPartnerHref: string;
}

interface Props {
  lang: Locale;
  /** Which page this is, per src/lib/i18n.ts ROUTES — drives the hreflang alternate and the
   *  EN/NL switch link. Pages with no nav entry in ROUTES (none currently) would need `null`. */
  page: PageKey;
  title: string;
  description: string;
  scriptSrc: "'none'" | "'self'";
  nav: NavContent;
  facts: FactsContent;
}

const { lang, page, title, description, scriptSrc, nav, facts } = Astro.props;
// Derived, not passed: the layout already knows the locale, and having callers compute this
// meant the same rule was written out in every page component.
const homeHref = localeHome(lang);
const csp = `default-src 'self'; script-src ${scriptSrc}; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'none'; img-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'none'`;
const altHref = altRouteFor(page, lang);

// Nav items shared by desktop and the mobile disclosure — one list, not two kept in lockstep.
const links = [
  { href: routeFor("offers", lang), label: nav.offers },
  { href: routeFor("cases", lang), label: nav.cases },
  { href: routeFor("trust", lang), label: nav.trust },
  { href: routeFor("about", lang), label: nav.about },
];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content={csp}>
<title>{title}</title>
<meta name="description" content={description}>
{altHref && <link rel="alternate" hreflang={lang === "nl" ? "en" : "nl"} href={withBase(altHref)}>}
<link rel="alternate" hreflang="x-default" href={withBase(routeFor("home", "nl"))}>
<link rel="canonical" href={new URL(withBase(routeFor(page, lang)), Astro.site)}>
<link rel="icon" href={withBase("/favicon.ico")} sizes="any">
<link rel="icon" type="image/svg+xml" href={withBase("/assets/icons/favicon.svg")}>
<link rel="icon" type="image/png" sizes="32x32" href={withBase("/assets/icons/favicon-32x32.png")}>
<link rel="icon" type="image/png" sizes="16x16" href={withBase("/assets/icons/favicon-16x16.png")}>
<link rel="apple-touch-icon" sizes="180x180" href={withBase("/assets/icons/apple-touch-icon.png")}>
<link rel="manifest" href={withBase("/assets/icons/site.webmanifest")}>
<meta name="theme-color" content="#0e0e2a">
</head>
<body>

<header class="topbar">
  <div class="bar">
    <a class="brand" href={withBase(homeHref)}><img class="logo" src={withBase("/assets/img/logo-fls-white.png")} alt="First Line Software"></a>

    <!-- CSS-only responsive nav, two renders of the same `links`/`solutions` arrays (same
         source, so they can't drift) rather than one: a <details> that hides all non-summary
         content when closed can't have that hiding reliably overridden by an author `display`
         rule at wider viewports in Chromium — the collapsed nav kept computing to zero width
         even with `display: flex !important`. Splitting into an always-flex desktop nav (hidden
         below the breakpoint) and a <details>-based mobile disclosure (hidden at/above it)
         sidesteps that entirely; each one only ever needs to do the simple, native thing. No
         script anywhere here, so marketing pages keep script-src 'none'. -->
    <nav class="primary-nav primary-nav-desktop" aria-label={nav.menuLabel}>
      <a href={withBase(routeFor("home", lang))}>{nav.home}</a>
      {links.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
    </nav>

    <details class="nav-toggle">
      <summary class="nav-toggle-summary" aria-label={nav.menuLabel}>
        <span class="nav-toggle-icon" aria-hidden="true"></span>
      </summary>
      <nav class="primary-nav primary-nav-mobile" aria-label={nav.menuLabel}>
        <a href={withBase(routeFor("home", lang))}>{nav.home}</a>
        {links.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
      </nav>
    </details>

    <!-- Right-hand cluster: page-supplied status/actions sit on the same baseline as the
         contact button and the EN/NL switch. -->
    <div class="bar-end">
      <slot name="topbar-actions" />
      {altHref && <a class="lang-switch" href={withBase(altHref)}>{nav.langSwitchLabel}</a>}
      <a class="contact-link" href={nav.contactHref}>{nav.contactLabel}</a>
    </div>
  </div>
</header>

<slot />

<footer class="site">
  <div class="wrap">
    <slot name="footer" />
    <div class="facts">
      <p class="facts-legal">{facts.legalName} · KvK {facts.kvk} · BTW {facts.btw}</p>
      <p class="facts-contact">{facts.address} · {facts.phone}</p>
      <p class="facts-links">
        <a href={withBase(facts.isoHref)}>{facts.isoLabel}</a>
        <a href={withBase(routeFor("privacy", lang))}>{facts.privacyLabel}</a>
      </p>
      <p class="facts-badges">
        <a href={facts.microsoftPartnerHref}><img class="facts-badge" src={withBase("/assets/img/badge-microsoft-partner.png")} alt={facts.microsoftPartnerLabel} loading="lazy"></a>
        <a href={facts.anthropicPartnerHref}><img class="facts-badge facts-badge-wide" src={withBase("/assets/img/badge-anthropic-partner.svg")} alt={facts.anthropicPartnerLabel} loading="lazy"></a>
      </p>
    </div>
    <p class="copyright">Copyright © 2026 First Line Software B.V.</p>
  </div>
</footer>

</body>
</html>
