---
import { withBase } from "../lib/url";
// Processed by Vite: minified, content-hashed, base-path aware. The @font-face
// URL inside resolves relative to the stylesheet, so the woff2 is emitted as a
// hashed asset too — no third-party font request either way.
import "../assets/css/site.css";

interface Props {
  lang: string;
  title: string;
  description: string;
  scriptSrc: "'none'" | "'self'";
  nav: { contactLabel: string; contactHref: string };
  /** Where the header logo links to — the homepage of the current locale, not always "/". */
  homeHref: string;
}

const { lang, title, description, scriptSrc, nav, homeHref } = Astro.props;
const csp = `default-src 'self'; script-src ${scriptSrc}; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'none'; img-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'none'`;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content={csp}>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href={withBase("/favicon.ico")} sizes="any">
<link rel="icon" type="image/svg+xml" href={withBase("/assets/icons/favicon.svg")}>
<link rel="icon" type="image/png" sizes="32x32" href={withBase("/assets/icons/favicon-32x32.png")}>
<link rel="icon" type="image/png" sizes="16x16" href={withBase("/assets/icons/favicon-16x16.png")}>
<link rel="apple-touch-icon" sizes="180x180" href={withBase("/assets/icons/apple-touch-icon.png")}>
<link rel="manifest" href={withBase("/assets/icons/site.webmanifest")}>
<meta name="theme-color" content="#0e0e2a">
</head>
<body>

<header class="topbar">
  <div class="bar">
    <a class="brand" href={withBase(homeHref)}><img class="logo" src={withBase("/assets/img/logo-fls-white.png")} alt="First Line Software"></a>
    <!-- Right-hand cluster: page-supplied status/actions sit on the same baseline as the
         contact button, and a future nav menu drops into the same row. -->
    <div class="bar-end">
      <slot name="topbar-actions" />
      <a class="contact-link" href={nav.contactHref}>{nav.contactLabel}</a>
    </div>
  </div>
</header>

<slot />

<footer class="site">
  <div class="wrap">
    <slot name="footer" />
    <p class="copyright">Copyright © 2026 First Line Software B.V. (KVK 58362126)</p>
  </div>
</footer>

</body>
</html>
