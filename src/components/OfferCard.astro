---
// One productized offer on /aanbod (spec §4.5): Microsoft-title-format name, scope, deliverables,
// duration, price (a band where the spec authorizes one, a bracketed placeholder otherwise —
// the card doesn't care which, it just renders whatever string the content gives it), and what
// happens after. ctaHref/ctaLabel are optional: only the free-scan step is "go do this now"
// rather than "get in touch," so it's the only card that needs its own link.
import { withBase } from "../lib/url";

interface Props {
  name: string;
  scope: string;
  deliverables: string[];
  duration: string;
  price: string;
  afterNote: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { name, scope, deliverables, duration, price, afterNote, ctaHref, ctaLabel } = Astro.props;
---
<article class="offer-card">
  <h3>{name}</h3>
  <p class="offer-scope">{scope}</p>
  <ul class="offer-deliverables">
    {deliverables.map((d) => <li>{d}</li>)}
  </ul>
  <div class="offer-meta">
    <span class="offer-duration">{duration}</span>
    <span class="offer-price">{price}</span>
  </div>
  <p class="offer-after">{afterNote}</p>
  {ctaHref && ctaLabel && <a class="btn btn-ghost" href={withBase(ctaHref)}>{ctaLabel}</a>}
</article>
