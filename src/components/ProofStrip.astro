---
// Home page proof strip (spec §4.1 block 4): a row of verified numbers/marks, each clickable to
// its evidence — never a bare claim. `href` is optional per metric since not everything has a
// public verification link yet (e.g. an unconfirmed outcome number).
import { withBase } from "../lib/url";

interface Metric {
  value: string;
  label: string;
  href?: string;
  /** Badge artwork (Microsoft/Anthropic partner logos) — replaces the plain-text value when
   *  set, since the logo itself is the verification. */
  imageSrc?: string;
  imageAlt?: string;
}
interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---
<div class="proof-strip">
  {metrics.map((m) => {
    const inner = m.imageSrc ? (
      <img class="proof-badge" src={withBase(m.imageSrc)} alt={m.imageAlt || m.value} loading="lazy">
    ) : (
      <span class="proof-value">{m.value}</span>
    );
    return m.href ? (
      m.href.startsWith("http") ? (
        <a class="proof-item" href={m.href} target="_blank" rel="noopener noreferrer">
          {inner}
          <span class="proof-label">{m.label}</span>
        </a>
      ) : (
        <a class="proof-item" href={withBase(m.href)}>
          {inner}
          <span class="proof-label">{m.label}</span>
        </a>
      )
    ) : (
      <span class="proof-item">
        {inner}
        <span class="proof-label">{m.label}</span>
      </span>
    );
  })}
</div>
