---
// The three capability teaser cards on the home page (spec §4.1 block 2), linking through to
// their full capability page.
import { withBase } from "../lib/url";

interface Props {
  heading: string;
  body: string;
  href: string;
  label: string;
}

const { heading, body, href, label } = Astro.props;
---
<article class="capability-card">
  <h3>{heading}</h3>
  <p>{body}</p>
  <a class="capability-card-link" href={withBase(href)}>{label}</a>
</article>
