---
// Spec §4.13.
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const common = (await getEntry("common", lang))!.data;
const privacy = (await getEntry("privacy", lang))!.data;
---
<BaseLayout lang={lang} page="privacy" title={privacy.meta.title} description={privacy.meta.description} scriptSrc="'none'" nav={common.nav} facts={common.facts}>

<div class="wrap">
<main class="prose">
  <h1>{privacy.heading}</h1>
  <p class="intro">{privacy.intro}</p>

  {privacy.sections.map((s) => (
    <section class="content">
      <h2>{s.heading}</h2>
      {s.paragraphs.map((p) => <p>{p}</p>)}
    </section>
  ))}

  <p>{privacy.contact}</p>
</main>
</div>

</BaseLayout>
