---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProseText from "./ProseText.astro";
import Hero from "./Hero.astro";
import { withBase } from "../lib/url";
import { routeFor, type Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const common = (await getEntry("common", lang))!.data;
const azure = (await getEntry("azure", lang))!.data;
---
<BaseLayout lang={lang} page="azure" title={azure.meta.title} description={azure.meta.description} scriptSrc="'self'" nav={common.nav} facts={common.facts}>

<!-- 0. Connectivity indicator — sits in the sticky topbar next to the contact button, so it
     stays visible while the reader scrolls through the export steps and into the scan. Labels
     are passed as data attributes rather than define:vars, which would force an inline script
     and break the CSP. Rendered without data-state: the stylesheet keeps it hidden until the
     script sets one. -->
<Fragment slot="topbar-actions">
  <span
    class="connectivity"
    role="status"
    data-connectivity
    data-label-online={azure.connectivity.online}
    data-label-offline={azure.connectivity.offline}
  >
    <!-- Both icons ship in the markup and CSS reveals one, so no client code builds DOM and
         nothing is fetched. Outline globe = connected, stated neutrally; solid airplane =
         the reader has cut the network and the scan carries on regardless. -->
    <svg class="ci ci-online" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"
      fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="9" />
      <ellipse cx="12" cy="12" rx="4" ry="9" />
      <path d="M3 12h18" />
    </svg>
    <svg class="ci ci-offline" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"
      fill="currentColor">
      <path d="M21 16v-2l-8-5V3.5C13 2.67 12.33 2 11.5 2S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" />
    </svg>
    <span class="connectivity-label sr-only reveal-from-sm" data-connectivity-text></span>
  </span>
</Fragment>

<!-- 1. Very short brief + two CTAs -->
<Hero hero={azure.hero}>
  <!-- A button, not a link: it navigates nothing on this page, it produces a report. -->
  <button slot="extra-cta" class="btn btn-ghost-dark" type="button" data-sample>{azure.app.sampleLabel}</button>
  <a slot="below-ctas" class="hero-export-link" href="#export">{azure.heroExportLinkLabel}</a>
</Hero>

<!-- 2. What you'll get — leads worth investigating -->
<section class="expect">
  <div class="wrap">
    <h2>{azure.expect.heading}</h2>
    <p class="intro">{azure.expect.intro}</p>
    <ul class="expect-list">
      {azure.expect.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<div class="wrap">
<main class="prose">

  <!-- 3. What's in the file, why it's safe, why it's free -->
  <section class="content" id="wat-zit-erin">
    <h2>{azure.files.heading}</h2>
    {azure.files.paragraphs.map((p) => (
      <p><ProseText text={p} newTabLabel={common.a11y.newTab} /></p>
    ))}
  </section>

  <section class="content">
    <h2>{azure.free.heading}</h2>
    {azure.free.paragraphs.map((p) => (
      <p><ProseText text={p} newTabLabel={common.a11y.newTab} /></p>
    ))}
  </section>

  <!-- 4. Export explanation -->
  <section class="content" id="export">
    <h2>{azure.export.heading}</h2>
    <p class="intro">{azure.export.intro}</p>

    <ol>
      {azure.export.steps.map((step) => (
        <li><ProseText text={step} newTabLabel={common.a11y.newTab} /></li>
      ))}
    </ol>
    <p>{azure.export.multiMonth}</p>

    <div class="note">{azure.export.noteRole}</div>
  </section>

</main>
</div>

<!-- 5. The app -->
<div class="wrap">
<section class="app" id="scan">
  <h2>{azure.app.heading}</h2>
  <p class="intro">{azure.app.intro}</p>

  <p class="trust-microcopy">
    {azure.trust.body}
    <a href={withBase(routeFor("privacy", lang))}>{azure.trust.privacyLabel}</a> ·
    <a href={withBase(routeFor("trust", lang))}>{azure.trust.vertrouwenLabel}</a>
  </p>

  <div id="scan-app" data-scan-app data-load-error={azure.app.loadError}>
    <div class="dropzone" data-dropzone tabindex="0" role="button" aria-label={azure.app.dropzone.ariaLabel}>
      <p><strong>{azure.app.dropzone.title}</strong> {azure.app.dropzone.suffix}</p>
      <p class="hint">{azure.app.dropzone.hint}</p>
      <input type="file" accept=".csv,text/csv" multiple hidden data-file-input>
    </div>

    <ul class="filelist" data-filelist hidden></ul>

    <div class="app-actions">
      <button class="btn btn-primary" type="button" data-analyze disabled>{azure.app.analyzeLabel}</button>
      <span class="app-status" data-status role="status" aria-live="polite"></span>
    </div>

    <noscript>
      <div class="note">{azure.app.noscript}</div>
    </noscript>
  </div>
</section>
</div>

<!-- 6. Bridge to the paid Azure Waste Audit -->
<div class="wrap">
<section class="bridge">
  <h2>{azure.bridge.heading}</h2>
  <p>{azure.bridge.body}</p>
  <a class="btn btn-primary" href={withBase(routeFor("offers", lang))}>{azure.bridge.linkLabel}</a>
</section>
</div>

<Fragment slot="footer">
  <ProseText text={azure.footer.text} newTabLabel={common.a11y.newTab} /> <a href={withBase(azure.footer.backLink.href)}>{azure.footer.backLink.label}</a>
</Fragment>
<script>
  // Vite code-splits the dynamic import below into its own hashed chunk and resolves the URL
  // against the configured base, so this works from a domain root or a project subpath
  // (e.g. /flsnl/) with no manual URL handling.
  import { initConnectivity } from "../scripts/connectivity.js";

  initConnectivity(document.querySelector("[data-connectivity]"));

  const mount = document.querySelector("[data-scan-app]");

  if (mount) {
    // Read off <html lang> (set by BaseLayout) rather than via define:vars: define:vars forces
    // Astro to inline this script instead of bundling it to an external, CSP-friendly file, and
    // this page's CSP has no 'unsafe-inline' in script-src.
    const lang = document.documentElement.lang || "nl";

    // One attempt, ever. A settled import() cannot be retried (see below), so "started" is
    // the only state the guard needs — success and failure are equally final.
    let started = false;
    let scanApi = null;
    // Holds the tab window.open() already returned, if the hero sample link is clicked before
    // scan.js has finished loading — filled in once ready instead of the click just landing as
    // a dead anchor jump. Cleared once consumed. Not a boolean: the window handle itself has to
    // survive until scan.js can navigate it to the finished PDF.
    let pendingSample = null;

    const load = () => {
      if (started) return;
      // Do not attempt a fetch that is guaranteed to fail. The browser caches a failed module
      // load in its module map, so a rejected import() of this specifier stays rejected for
      // the life of the document — one doomed attempt while offline would permanently poison
      // the retry below. Skipping leaves the first real attempt for the `online` event.
      if (!navigator.onLine) return;
      started = true;
      import("../scripts/scan.js")
        .then((mod) => {
          scanApi = mod.init(mount, lang);
          if (pendingSample) {
            const win = pendingSample;
            pendingSample = null;
            scanApi.viewSample(win);
          }
        })
        .catch((err) => {
          // Nothing to reset: per the note above, retrying this specifier can never succeed,
          // so the reader is told to reload instead.
          const status = mount.querySelector("[data-status]");
          const message = mount.dataset.loadError;
          if (status && message) {
            status.textContent = message;
            status.classList.add("error");
          }
          // Surface the real cause in the console for debugging.
          console.error("scan.js failed to load", err);
        });
    };

    // Fetch eagerly, but off the critical path. This deliberately replaces the earlier
    // load-on-scroll: the connectivity strip invites the reader to switch on airplane mode as
    // soon as it says "ready", and a scanner that only downloads once #scan nears the viewport
    // would then fail to arrive. Idle time costs ~16 KB gzip after first paint and buys a page
    // that genuinely works end-to-end with the network off.
    if ("requestIdleCallback" in window) {
      requestIdleCallback(load, { timeout: 2000 });
    } else {
      setTimeout(load, 200);
    }

    // Recover without a reload if the page was opened offline.
    window.addEventListener("online", load);

    // Hero "Bekijk een voorbeeldrapport" button: opens the sample PDF in a new tab rather than
    // downloading it, and does nothing else — it is not a link and moves the current page
    // nowhere. The tab has to open synchronously, right here in the click handler, before any
    // await runs anywhere — a window.open() called later (once scan.js/jsPDF have loaded and
    // the PDF is built) is no longer inside the original user gesture as far as popup blockers
    // are concerned, and gets silently blocked.
    const heroSample = document.querySelector(".hero [data-sample]");
    if (heroSample) {
      heroSample.addEventListener("click", () => {
        const win = window.open("", "_blank");
        if (scanApi) { scanApi.viewSample(win); return; }
        pendingSample = win;
        load(); // in case idle time hasn't fired yet — load() itself is idempotent
      });
    }
  }
</script>
</BaseLayout>
