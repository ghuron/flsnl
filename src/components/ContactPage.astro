---
// Spec §4.10 — form-free by design: booking link + mailto, not a contact form.
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
import { routeFor, type Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const common = (await getEntry("common", lang))!.data;
const contact = (await getEntry("contact", lang))!.data;
---
<BaseLayout lang={lang} page="contact" title={contact.meta.title} description={contact.meta.description} scriptSrc="'none'" nav={common.nav} facts={common.facts}>

<div class="wrap">
<main class="prose">
  <h1>{contact.heading}</h1>
  <p class="intro">{contact.intro}</p>

  <div class="contact-cards">
    {contact.contacts.map((c) => {
      const mailtoHref = c.email.startsWith("[") ? undefined : `mailto:${c.email}`;
      const initials = c.name.split(/\s+/).map((p) => p[0]).join("").slice(0, 2).toUpperCase();
      return (
        <section class="content contact-card">
          {c.photoSrc
            ? <img class="cta-photo contact-photo" src={withBase(c.photoSrc)} alt={c.name} width="72" height="72">
            : <span class="cta-photo cta-photo-fallback contact-photo" aria-hidden="true">{initials}</span>}
          <p class="contact-name"><strong>{c.name}</strong> — {c.role}</p>
          <ul class="contact-details">
            <li>{mailtoHref ? <a href={mailtoHref}>{c.email}</a> : c.email}</li>
            {c.phone && <li>{c.phone}</li>}
            <li><a href={c.linkedinHref} target="_blank" rel="noopener noreferrer">{c.linkedinLabel}</a></li>
          </ul>
          <a class="btn btn-primary" href={c.bookingHref}>{c.bookingLabel}</a>
        </section>
      );
    })}
  </div>
  <p class="cta-promise" style="margin: -1rem 0 1.5rem; color: var(--ink-dim);">{contact.responsePromise}</p>

  <section class="content">
    <h2>{contact.address.heading}</h2>
    {contact.address.lines.map((l) => <p style="margin: 0;">{l}</p>)}
  </section>

  <section class="content">
    <p>{contact.procurement.body} <a href={withBase(routeFor("trust", lang))}>{contact.procurement.linkLabel}</a></p>
  </section>
</main>
</div>

</BaseLayout>
