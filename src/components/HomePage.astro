---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import { withBase } from "../lib/url";
import type { Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const nav = (await getEntry("common", lang))!.data.nav;
const home = (await getEntry("home", lang))!.data;
---
<BaseLayout lang={lang} title={home.meta.title} description={home.meta.description} scriptSrc="'none'" nav={nav}>

<Hero hero={home.hero} />

<div class="wrap">
  <div class="promo">
    <div>
      <span class="tag">{home.promo.tag}</span>
      <h2>{home.promo.heading}</h2>
      <p>{home.promo.body}</p>
      <a class="btn btn-primary" href={withBase(home.promo.cta.href)}>{home.promo.cta.label}</a>
    </div>
    <div class="promo-visual" aria-hidden="true"></div>
  </div>
</div>

<Fragment slot="footer">{home.footer.text}</Fragment>
</BaseLayout>
